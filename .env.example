# Fill in all four password values before running Docker Compose.
# PrintMate Environment Configuration Template
# Copy this file to .env before starting Docker Compose: cp .env.example .env

# Server & Application
SERVER_PORT=8080
MANAGEMENT_PORT=8081
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=printmate
DB_USERNAME=printmate_user
DB_PASSWORD=

# Storage
UPLOAD_DIR=/app/uploads

# Default Admin Seed Account
ADMIN_AUTO_CREATE=true
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@printmate.com
ADMIN_PASSWORD=
ADMIN_PHONE=+8801700000000

# Default Operator Seed Account
OPERATOR_AUTO_CREATE=true
OPERATOR_NAME=Shop Operator
OPERATOR_EMAIL=operator@printmate.com
OPERATOR_PASSWORD=
OPERATOR_PHONE=+8801800000000

# Monitoring
PROMETHEUS_PUBLIC_URL=http://localhost:9090
GRAFANA_PUBLIC_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
