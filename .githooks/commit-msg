#!/bin/sh
# PrintMate Local Conventional Commit Message Hook
# Enforces: type(scope): description

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# Conventional commit regex
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\([a-z0-9\-]+\): .+$"

# Allow merge commits or revert commits generated by git
if echo "$COMMIT_MSG" | grep -qE '^Merge branch' || echo "$COMMIT_MSG" | grep -qE '^Revert "'; then
  exit 0
fi

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "===================================================================="
  echo " [ERROR] INVALID COMMIT MESSAGE FORMAT"
  echo "===================================================================="
  echo " Your commit message:"
  echo "   \"$COMMIT_MSG\""
  echo ""
  echo " Commit messages must strictly follow the Conventional Commits format:"
  echo "   type(scope): imperative description"
  echo ""
  echo " Allowed types:"
  echo "   feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo ""
  echo " Valid Examples:"
  echo "   feat(auth): implement customer registration"
  echo "   fix(pricing): correct double-sided printing calculation"
  echo "   test(order): add status transition unit tests"
  echo "   docs(api): update openapi endpoint documentation"
  echo "===================================================================="
  echo ""
  exit 1
fi

exit 0

